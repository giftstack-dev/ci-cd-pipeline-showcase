# Frontend environment variables
# Copy this to .env for local frontend development

# Base URL for the FastAPI backend service
# In local development: http://localhost:8000
# In staging/production: https://staging-api.example.com
# If left empty or unreachable, the dashboard automatically enters Demo Mode
VITE_API_URL=http://localhost:8000

# Base public path for Vite build (e.g. /ci-cd-pipeline-showcase/ for GitHub Pages)
VITE_BASE_PATH=/

# Semantic version injected by GitHub Actions workflow during build
VITE_APP_VERSION=1.0.0

# Git commit SHA injected by GitHub Actions workflow during build
VITE_COMMIT_SHA=dev-local

# Build timestamp (ISO 8601) injected during CI build
VITE_BUILD_TIME=2026-11-04T00:00:00Z
