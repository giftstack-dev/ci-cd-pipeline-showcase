# Backend environment variables
# Copy this to .env for local backend development

# Application Environment (development, staging, production)
APP_ENV=development

# Semantic version of the backend release (injected at build time by CI)
VERSION=0.0.0-dev

# Git commit SHA (injected at build time by CI)
COMMIT_SHA=local

# ISO 8601 build timestamp (injected at build time by CI)
BUILD_TIME=unknown

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,https://giftstack-dev.github.io
